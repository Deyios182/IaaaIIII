# Gemini API Key (Required for AI conversations)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (Required for memory and user data)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# User ID (Will be replaced by auth in the future)
VITE_USER_ID=your_user_uuid_here

# OpenRouter API Key (Optional - for AI second opinion feature)
# Access to multiple models: Grok, GPT-4, Claude, Gemini Pro, etc.
# Get your key at: https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
